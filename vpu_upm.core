CAPI=2:

name: "ceiupm::vpu_upm"
description: "Vector Processing Unit Zve32x"

filesets:
    files_rtl:
        depend:
            - pulp-platform.org::common_cells  
        files:
            - rtl/include/cvxif_types_pkg.sv
            - rtl/include/obi_pkg.sv
            - rtl/include/rvv_instr_pkg.sv
            - build/generated/vpu_pkg.sv
            - rtl/if_xif_exe.sv
            - rtl/vendor/obione/rtl/obione.sv
            - rtl/obi_lsu_top.sv
            - rtl/vpu_vau.sv
            - rtl/vpu_simd_block.sv
            - rtl/vpu_simd_controller.sv
            - rtl/vpu_decoder.sv
            - rtl/vpu_xif_decoder.sv
            - rtl/vpu_dispatch.sv
            - rtl/vpu_control_unit.sv
            - rtl/vpu_vregfile.sv
            - rtl/vpu_sldu.sv
            - rtl/vpu_top.sv
            - rtl/include/utils_macros.svh: {is_include_file: true}
        file_type: systemVerilogSource
        # include_dirs:
        #   - rtl/include

    # files_common_cells:
    #     depend:
    #         - pulp-platform.org::common_cells  
        # files:
        # - rtl/vendor/pulp_platform/common_cells/src/fifo_v3.sv
        # #- rtl/vendor/pulp_platform/common_cells/include/common_cells/assertions.svh: {is_include_file: true}
        # - rtl/vendor/pulp_platform/common_cells/include/common_cells/assertions.svh:
        #     is_include_file: true
        #     include_path: rtl/vendor/pulp_platform/common_cells/include
        # file_type: systemVerilogSource
        # # include_dirs:
        # #   - rtl/vendor/pulp_platform/common_cells/include
    
    files_tb:
        files:
        #- tb/vpu_stimulus_gen.sv
        # - tb/vpu_pipeline_checker.sv
        - tb/tb_vpu_pkg.sv
        - tb/cvxif_cpu_model.sv
        - tb/obi_mem_model.sv
        - tb/tb_vpu_common.svh:    {is_include_file: true}
        - tb/tb_vpu_alu.sv
        - tb/tb_vpu_top.sv
        - tb/tb_vpu_dispatch.sv
        - tb/tb_vpu_csr.sv
        - tb/tb_vpu_xif_decoder.sv
        - tb/tb_vpu_obi_lsu_top.sv
        - tb/tb_vpu_top_lsu_eew.sv
        - tb/tb_vpu_top_vmv.sv
        - tb/tb_vpu_top_vmv_scalar.sv
        - tb/tb_vpu_top_vmvnr.sv
        - tb/tb_vpu_top_vreduction.sv
        - tb/tb_vpu_top_vmul.sv
        - tb/tb_vpu_top_varith.sv
        - tb/tb_vpu_top_vmask.sv
        file_type: systemVerilogSource
        # include_dirs:
        #   - tb

targets:
    default:
        filesets:
        # - files_common_cells
        - files_rtl

    vpu-sim:
        default_tool: modelsim
        filesets:
        # - files_common_cells
        - files_rtl
        - files_tb
        toplevel: tb_vpu_top
        tools:
            modelsim:
                vlog_options:
                - -sv